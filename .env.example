DATABASE_URL=postgresql+asyncpg://atmo_derma:change-me@localhost:5432/atmo_derma
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5/weather
OPENWEATHERMAP_AIR_QUALITY_URL=https://api.openweathermap.org/data/2.5/air_pollution
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
SECRET_KEY=replace-with-a-long-random-value
# Outdoor data is live Open-Meteo by default. Only the indoor device remains simulated.
DEMO_MODE=false
ENVIRONMENT_REFRESH_MINUTES=10
ENVIRONMENT_POLL_SECONDS=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
